# =============================================================================
# Environment configuration for the AI Powered Financial Dashboard
# Copy this file to ".env" and override only what you need.
# =============================================================================

# --- Web server ---------------------------------------------------------------
# Port published on the host; the container always listens on 8050 internally.
DASHBOARD_PORT=8050

# --- Ollama -------------------------------------------------------------------
# Where the dashboard reaches Ollama.
#   Bundled Ollama (--profile bundled-ollama): http://ollama:11434
#   Ollama already running on the host (Linux): http://172.17.0.1:11434
#   Ollama already running on the host (macOS/Windows): http://host.docker.internal:11434
OLLAMA_URL=http://ollama:11434

# Model used for the written commentary.
#   llama3.2:3b   (~2 GB)   light and fast; the default
#   llama3.1:8b   (~4.7 GB) more nuanced, needs roughly 8 GB of free memory
#   mistral:7b    (~4.1 GB) strong reasoning
#   phi3:mini     (~2.3 GB) very fast, English-leaning
OLLAMA_MODEL=llama3.2:3b

# Seconds to wait for a completion. The first call after startup is slow while
# the model loads into memory.
OLLAMA_TIMEOUT=120

# --- Locale -------------------------------------------------------------------
# IANA timezone used for the "last update" timestamp.
TZ=UTC

# Currency label passed to the model so it describes amounts correctly.
CURRENCY=BRL

# Symbol shown on chart axes and tooltips. Kept separate from CURRENCY above:
# the model reads a code, the chart needs a printable symbol, and the two
# don't always match ("R$" for BRL, "$" is ambiguous between USD/CAD/AUD/etc).
CURRENCY_SYMBOL=R$

# --- Authentication -----------------------------------------------------------
# Basic auth sends credentials in clear text. Enable it only behind TLS or on a
# trusted network such as a private VPN.
REQUEST_PASSWORD=0

# Comma-separated "user:password" pairs. Required when REQUEST_PASSWORD=1.
# DASHBOARD_USERS=alice:change-me,bob:change-me-too

# --- Backups ------------------------------------------------------------------
# Snapshots of the SQLite database. Two kinds, each pruned on its own:
#   scheduled  at start-up, then every BACKUP_INTERVAL_HOURS
#   safety     right before a delete or an edit, at most one per
#              BACKUP_SAFETY_MIN_MINUTES
# The defaults below are what the app uses when these lines are left out.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_SCHEDULED=14
BACKUP_SAFETY_MIN_MINUTES=60
BACKUP_KEEP_SAFETY=20

# Where snapshots are written, as a path INSIDE the container. Empty means
# ./data/backups, beside the database: that protects against mistakes and bugs
# but not against losing the disk. To survive a disk failure, mount another
# drive in docker-compose.yaml (the commented "/backups" volume there) and set:
# BACKUP_DIR=/backups
BACKUP_DIR=

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=INFO

# Host address for the published port. Use 127.0.0.1 when a reverse proxy
# (e.g. Tailscale Serve) fronts the dashboard on the same port.
# DASHBOARD_BIND=0.0.0.0
